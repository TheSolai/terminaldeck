*.log
# TUI agent session captures
tmux-client-*.log
tmux-server-*.log

# ─── OS preferences (don't commit user QSettings) ──────────────────────
*.plist
!Info.plist

# ─── Temp / local ───────────────────────────────────────────────────────
tmp/
.tmp/
.cache/
# ── Screenshots (dev only, not shipped) ──────────────────────────────
screenshots/
